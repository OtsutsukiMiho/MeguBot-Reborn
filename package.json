{
  "name": "megu",
  "version": "1.0.0",
  "description": "Megu — Discord bot and group activity manager, by Megux Corp",
  "license": "ISC",
  "author": "Megux Corp",
  "contributors": [
    "NozomiSanZ"
  ],
  "main": "index.js",
  "scripts": {
    "dev": "node .",
    "start": "node index.js",
    "build": "next build",
    "deploy": "node deploy-commands.js",
    "boot": "node deploy-commands.js && node .",
    "test": "node tests/run.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:seed": "node scripts/seed-demo.js",
    "db:audit": "node scripts/db-audit.js",
    "contrast": "node scripts/contrast-audit.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.3.0",
    "google-tts-api": "^2.0.2",
    "lucide-react": "^1.29.0",
    "next": "^16.3.0",
    "node-edge-tts": "^1.2.10",
    "opusscript": "^0.0.8",
    "pg": "^8.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0"
  }
}
