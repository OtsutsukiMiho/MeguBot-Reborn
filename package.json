{
  "name": "megu",
  "version": "1.0.0",
  "description": "Megu — Discord bot and group activity manager, by Megux Corp",
  "license": "ISC",
  "author": "Megux Corp",
  "contributors": [
    "NozomiSanZ"
  ],
  "main": "index.js",
  "scripts": {
    "dev": "node .",
    "start": "node index.js",
    "build": "node scripts/vendor-ocr.js && next build",
    "ocr:setup": "node scripts/vendor-ocr.js",
    "deploy": "node deploy-commands.js",
    "boot": "node index.js",
    "test": "node tests/run.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:seed": "node scripts/seed-demo.js",
    "db:seed:payment": "node scripts/seed-payment-demo.js",
    "db:seed:discord-payment": "node scripts/seed-discord-payment-test.js",
    "db:seed:discord-due": "node scripts/seed-discord-due-test.js",
    "db:restore:discord-payment": "node scripts/restore-discord-payment-test.js",
    "db:audit": "node scripts/db-audit.js",
    "merge:demo": "node scripts/merge-demo.js",
    "contrast": "node scripts/contrast-audit.js",
    "bot:instances": "node scripts/instance-audit.js",
    "dev:login": "node scripts/dev-login.js",
    "cloud:setup": "bash scripts/cloud-setup.sh"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^13.1.1",
    "google-auth-library": "^10.9.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.29.0",
    "next": "^16.3.0",
    "node-edge-tts": "^1.2.10",
    "opusscript": "^0.0.8",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0"
  }
}
